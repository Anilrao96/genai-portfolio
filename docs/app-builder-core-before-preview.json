        "stage": "backend",
        "source": "from itertools import count\nfrom typing import Annotated\n\nfrom fastapi import FastAPI, HTTPException, Response\nfrom pydantic import BaseModel, StrictBool, StringConstraints\n\napp = FastAPI()\nitems = {}\nnext_id = count(1)\n\n\nclass CreateItem(BaseModel):\n    title: Annotated[str, StringConstraints(strip_whitespace=True, min_length=1, max_length=80)]\n\n\nclass UpdateItem(BaseModel):\n    done: StrictBool\n\nfrom itertools import count\n\nitems = {}\nnext_id = count(1)\n\ndef list_items():\n    return list(items.values())\n\ndef create_item(title):\n    item_id = next(next_id)\n    items[item_id] = {'id': item_id, 'title': title, 'done': False}\n    return items[item_id]\n\ndef update_item(item_id, done):\n    items[item_id]['done'] = done\n    return items[item_id]\n\ndef delete_item(item_id):\n    del items[item_id]\n\n@app.get('/api/items')\nasync def api_list():\n    return list_items()\n\n\n@app.post('/api/items', status_code=201)\nasync def api_create(payload: CreateItem):\n    return create_item(payload.title)\n\n\n@app.patch('/api/items/{item_id}')\nasync def api_update(item_id: int, payload: UpdateItem):\n    if item_id not in items:\n        raise HTTPException(status_code=404, detail='Item not found')\n    return update_item(item_id, payload.done)\n\n\n@app.delete('/api/items/{item_id}', status_code=204)\nasync def api_delete(item_id: int):\n    if item_id not in items:\n        raise HTTPException(status_code=404, detail='Item not found')\n    delete_item(item_id)\n    return Response(status_code=204)\n",
        "note": "The backend role generated the tracker functions for the trusted FastAPI routes.",
