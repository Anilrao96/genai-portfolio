        "stage": "frontend",
        "source": "import React, { useState } from 'react';\n\nconst App = ({ title, itemLabel, items, input, onInput, onAdd, onToggle, onDelete, busy, loading, error }) => {\n  return (\n    <main>\n      <h1>{title}</h1>\n      <form onSubmit={onAdd}>\n        <label htmlFor=\"item-input\">Add {itemLabel}: </label>\n        <input\n          id=\"item-input\"\n          type=\"text\"\n          value={input}\n          onChange={onInput}\n          data-testid=\"item-input\"\n        />\n        <button type=\"submit\">Add</button>\n      </form>\n      {loading && <p>Loading...</p>}\n      {error && <p>Error: {error}</p>}\n      {items.length === 0 && <p>No {itemLabel} in the list.</p>}\n      {items.map((item, index) => (\n        <li key={index}>\n          <input\n            type=\"checkbox\"\n            checked={item.done}\n            onChange={() => onToggle(item)}\n            data-testid=\"item-toggle\"\n          />\n          <span data-testid=\"item-label\">{item.title}</span>\n          <button\n            type=\"button\"\n            onClick={() => onDelete(item.id)}\n            data-testid=\"item-delete\"\n          >\n            Delete\n          </button>\n        </li>\n      ))}\n    </main>\n  );\n};\n\nexport default App;",
