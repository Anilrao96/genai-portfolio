      {
        "stage": "frontend",
        "source": "import React, { useState } from 'react';\n\nconst App = ({ title, itemLabel, items, input, onInput, onAdd, onToggle, onDelete, busy, loading, error }) => {\n  return (\n    <main>\n      <h1>{title}</h1>\n      <form onSubmit={onAdd}>\n        <label htmlFor=\"input\">{itemLabel}</label>\n        <input type=\"text\" id=\"input\" value={input} onChange={onInput} />\n        <button type=\"submit\">Add</button>\n      </form>\n      {loading && <p>Loading...</p>}\n      {error && <p>Error: {error}</p>}\n      {!loading && !error && items.length === 0 && <p>No items yet.</p>}\n      {!loading && !error && items.length > 0 && (\n        <ul>\n          {items.map(item => (\n            <li key={item.id}>\n              <input type=\"checkbox\" checked={item.done} onChange={() => onToggle(item)} />\n              {item.title}\n              <button onClick={() => onDelete(item.id)}>Delete</button>\n            </li>\n          ))}\n        </ul>\n      )}\n    </main>\n  );\n};\n\nexport default App;",
